# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.
#   cp .env.example .env
# Then load it into your shell before running any script:
#   set -a && source .env && set +a

# Required for the OpenAI judge (gpt-4.1-mini in the paper)
OPENAI_API_KEY=sk-your-key-here
JUDGE_MODEL=gpt-4.1-mini

# Optional: use a local Ollama model instead (06b_judge.py only). Leave empty for OpenAI.
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=qwen3:8b
